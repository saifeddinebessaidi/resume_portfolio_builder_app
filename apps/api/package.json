{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "description": "REACCHY Career Builder API — NestJS 11 on Fastify, Prisma, Neon Postgres",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "verify:invoice-numbers": "node -r ts-node/register scripts/verify-invoice-numbers.ts"
  },
  "prisma": {
    "seed": "node -r ts-node/register prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-fastify": "^11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@prisma/client": "^6.19.3",
    "@repo/contracts": "workspace:*",
    "dotenv": "^17.4.2",
    "fastify": "^5.11.2",
    "jose": "^6.2.8",
    "nestjs-pino": "^4.6.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@repo/config": "workspace:*",
    "@types/node": "^22.20.1",
    "eslint": "^9.39.5",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.19.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}

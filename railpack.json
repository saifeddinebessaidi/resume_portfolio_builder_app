{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "build": {
      "inputs": [{ "step": "install" }],
      "commands": [
        "pnpm --filter @repo/api exec prisma generate",
        "pnpm turbo run build --filter=@repo/api..."
      ]
    }
  },
  "deploy": {
    "startCommand": "pnpm --filter @repo/api start"
  }
}

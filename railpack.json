{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "build": {
      "commands": [
        "pnpm --filter @repo/contracts build",
        "pnpm --filter @repo/api exec prisma generate",
        "pnpm --filter @repo/api build"
      ]
    }
  },
  "deploy": {
    "startCommand": "pnpm --filter @repo/api start"
  }
}
